# Supabase
# URL y anon key: Supabase Dashboard > Project Settings > API (son públicas, seguras de exponer)
SUPABASE_URL=https://tyxugmbnpszilcgguwlw.supabase.co
SUPABASE_ANON_KEY=

# Service role key: Supabase Dashboard > Project Settings > API > service_role
# SECRETA. Nunca la subas al repo, nunca la mandes al frontend. Solo vive en el
# entorno del servidor (backend/.env local, o variables de entorno de Vercel).
SUPABASE_SERVICE_ROLE_KEY=

# Servidor
PORT=3000
NODE_ENV=development

# URL pública del frontend (para links de recuperación de contraseña, etc.)
FRONTEND_URL=http://localhost:5173

# Acceso rápido por rol en el login (true por defecto). En producción con usuarios reales: false
DEMO_LOGIN_ENABLED=true
DEMO_EMAIL_DOMAIN=indusecc.com

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# Email (opcional, para notificaciones y recuperación de contraseña con marca propia)
EMAIL_SERVICE=gmail
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_contraseña_app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Logging
LOG_LEVEL=info
